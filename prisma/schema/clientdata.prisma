  propertyModule PropertyModule @relation(fields: [propertyModuleId],references: [id],onDelete: Cascade)

  roomTypeFeatures  RoomTypeFeature[]
  roomTypeAmenities RoomTypeAmenity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyModuleId, code])
  @@unique([propertyModuleId, name])
  @@unique([propertyModuleId, upgradeLevel])
  @@unique([propertyModuleId, displaySequence])

  @@index([propertyModuleId])
}

