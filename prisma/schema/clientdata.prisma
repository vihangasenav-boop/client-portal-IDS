// MISCELLANEOUS

enum DepartmentModules {
  FrontOffice    @map("Front Office")
  PointOfSale    @map("Point of Sale")
  Housekeeping
  SalesMarketing @map("Sales & Marketing")
  Finance
}


model Departments {
  id               Int      @id @default(autoincrement())
  propertyModuleId Int
  designationId    Int

  code             String
  name             String
  departmentModule DepartmentModules
  isDefault        Boolean @default(false)

  propertyModule PropertyModule @relation(fields: [propertyModuleId], references: [id], onDelete: Cascade)
  designation    Designations @relation(fields: [designationId], references: [id], onDelete: Restrict)
  sections       Sections[]
  traceDefinitions TraceDefinitions[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyModuleId, code])
  @@index([propertyModuleId])
  @@index([designationId])
}

model Sections {
  id           Int @id @default(autoincrement())
  departmentId Int

  code      String
  name      String
  isDefault Boolean @default(false)

  department  Departments @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([departmentId, code])
  @@index([departmentId])
}

enum Operations {
  CancelReservations @map("Cancel Reservations")
  DeleteReservations @map("Delete Reservations")
}

model Reasons {
  id               Int      @id @default(autoincrement())
  propertyModuleId Int

  code             String
  name             String
  departmentModule DepartmentModules
  operations Operations

  propertyModule PropertyModule @relation(fields: [propertyModuleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyModuleId, code])
  @@index([propertyModuleId])
}

model TraceDefinitions {
  id           Int @id @default(autoincrement())
