// FOM Data Collection Table

// Business Source Groups

model AccountType {
  id               Int @id @default(autoincrement())
  propertyModuleId Int

  code      String
  name      String
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  propertyModule PropertyModule @relation(fields: [propertyModuleId], references: [id], onDelete: Cascade)

  subAccountTypes SubAccountType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyModuleId, code])
  @@index([propertyModuleId])
}

model SubAccountType {
  id            Int @id @default(autoincrement())
