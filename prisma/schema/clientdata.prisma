  @@id([roomTypeId, roomAmenityId])
  @@index([roomAmenityId])
}

// CASHIERING

enum RevenueClassifications{
  Cash
  CreditCard @map("Credit Card")
  FrontOfficeCharge @map("Front Office Charge")
  FAndBOutlet @map("F&B Outlet")
  NonFAndBOutlet @map("NON F&B Outlet")
  RoomRate @map("Room Rate")
  Tax
  MealPlan @map("Meal Plan")
  LoyaltyRedemptions @map("Loyalty Redemptions")
  GiftVoucher @map("Gift Voucher")
}

enum RevenueType{
  Both
  Debit
  Credit
}

enum Sac_Hsn{
  SAC
  HSN
}

model Revenue {
  id               Int      @id @default(autoincrement())
  propertyModuleId Int

  code             String
  name             String
  classification   RevenueClassifications
  type             RevenueType
  Sac_Hsn          Sac_Hsn
  sacHsnNumber     String   @default("")

  displaySequence  Int      @default(0)
  isDefault        Boolean  @default(false)
  isActive         Boolean  @default(true)

  propertyModule PropertyModule @relation(fields: [propertyModuleId], references: [id], onDelete: Cascade)
  revenueGroups  RevenueGroup[]
  paymentInstructions PaymentInstructions[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyModuleId, code])
  @@index([propertyModuleId])
}

enum Group{
  Accomodation
  TransportRevenue @map("Transport Revenue")
  ShopSales @map("Shop Sales")
  FAndBFloorCode @map("F&B floorCode")
  Tax
}

model RevenueGroup {
  id               Int      @id @default(autoincrement())
  propertyModuleId Int

  code             String
  name             String
  revenueGroupClassification Group
  revenueName                Revenue[]
  Sac_Hsn                    Sac_Hsn
  sacHsnNumber               String   @default("")

  isDefault        Boolean  @default(false)
  isActive         Boolean  @default(true)

  propertyModule PropertyModule @relation(fields: [propertyModuleId], references: [id], onDelete: Cascade)
  paymentInstructions PaymentInstructions[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyModuleId, code])
  @@index([propertyModuleId])
}

enum Payments{
  Cash
  CreditCard
  Cityledger
  Cheque
}

model PaymentInstructions {
  id               Int      @id @default(autoincrement())
  propertyModuleId Int

  code             String
  name             String
  nameMultilingual String
  displaySequence  Int      @default(0)
  description      String?
  revenueGroups    RevenueGroup[]
  revenueName      Revenue[]
  split            Int      @default(0)
  paymentType      Payments
  transactionLimit Decimal? @db.Decimal(10, 2)
  forcePayment     Boolean  @default(false)
  
  propertyModule PropertyModule @relation(fields: [propertyModuleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyModuleId, code])
  @@index([propertyModuleId])
}



